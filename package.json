{
  "name": "just-invoicing-things",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3773",
    "build": "cf build",
    "serve": "vite preview",
    "test": "bun test --pass-with-no-tests",
    "deploy": "bun run build && cf deploy --prebuilt",
    "preview": "bun run build && vite preview",
    "cf-typegen": "cf workers types",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check",
    "fix": "bun run lint:fix && bun run format"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@irshadnazree/just-things-ui": "^0.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.167.5",
    "@ui-sdk/core": "^0.1.0-beta.16",
    "@ui-sdk/react": "^0.1.0-beta.16",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@interfere/landmines": "0.2.1",
    "@shadcn/lint": "^0.2.5",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "^1.0.0-rc.4",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.94.0",
    "simple-git-hooks": "^2.13.1",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "^6.0.2",
    "vite": "^8.0.5",
    "web-vitals": "^5.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "simple-git-hooks"
  ]
}
